# Copy to ~/.config/agentdeck/staging.env and chmod 600.
# Never commit the populated file.

OPENROUTER_API_KEY=

R2_RELAY_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_RELAY_BUCKET=agentdeck
R2_RELAY_ACCESS_KEY_ID=
R2_RELAY_SECRET_ACCESS_KEY=

# Optional. This is the OpenRouter model reference used by both platforms.
AGENTDECK_MODEL=openrouter/auto

# Optional identity labels shown in AgentDeck.
OPENCLAW_SERVER_ID=agentdeck-openclaw
HERMES_SERVER_ID=agentdeck-hermes
