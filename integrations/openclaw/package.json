{
  "name": "r2-relay-channel",
  "version": "0.4.0",
  "description": "R2 Relay Channel is a secure, decentralized OpenClaw messaging channel that keeps delivery simple while preserving data ownership without relying on an IM provider.",
  "type": "module",
  "main": "dist/r2-relay.js",
  "types": "dist/r2-relay.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/check-openclaw-version.mjs && tsc -p tsconfig.json && node scripts/prepare-dist.mjs",
    "test": "npm run build && node --test dist/*.test.js",
    "test:lifecycle": "node ../../tools/maintenance/openclaw-plugin-lifecycle.mjs",
    "e2e:transport": "R2_RELAY_E2E_MODE=transport node e2e/run-openclaw-e2e.mjs",
    "e2e:openclaw": "node e2e/run-openclaw-e2e.mjs",
    "lint": "echo 'no-lint-config'",
    "pack": "npm pack"
  },
  "author": "Wei Wu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dodid/AgentDeck.git",
    "directory": "integrations/openclaw"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1119.0",
    "@aws-sdk/s3-request-presigner": "3.1119.0",
    "openclaw": "^2026.7.1-2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/r2-relay.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "r2-relay-channel",
      "label": "R2 Relay by AgentDeck App",
      "selectionLabel": "R2 Relay by AgentDeck App",
      "docsPath": "/channels/r2-relay-channel",
      "docsLabel": "r2-relay-channel",
      "blurb": "Cloudflare R2-backed relay channel for direct text messages.",
      "order": 120
    }
  }
}
